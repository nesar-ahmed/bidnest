{
  "name": "@bidnest/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "db:migration:create": "typeorm-ts-node-commonjs migration:create",
    "db:migrate": "ts-node src/database/run-migrations.ts",
    "db:migrate:revert": "ts-node src/database/run-migrations.ts --revert",
    "db:seed": "ts-node src/database/seeds/run-seeds.ts",
    "db:reset": "ts-node src/database/reset-database.ts",
    "db:show": "ts-node src/database/show-data.ts"
  },
  "dependencies": {
    "@bidnest/shared": "*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@bidnest/config-typescript": "*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.10",
    "@swc/core": "^1.16.22",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
