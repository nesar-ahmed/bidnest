# apps/api environment — copy to apps/api/.env (git-ignored).
#
# src/config/env.ts loads apps/api/.env from its real location, so the same
# values apply whether you run from apps/api or the repo root. Real process
# environment variables always win over the file.
PORT=4000
WEB_ORIGIN=http://localhost:3000

# SQLite file; relative paths resolve against apps/api (not the cwd).
# Do not create it by hand: `npm run db:migrate` creates it on first run.
# Tests override this with DATABASE_FILE=:memory:.
DATABASE_FILE=./bidnest.db

# REQUIRED in production — signs the access JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-insecure-secret-change-me

# Log every TypeORM query (noisy; useful when debugging a migration).
DB_LOGGING=false

# Schema is migration-managed (npm run db:migrate); dev accounts are
# created explicitly with `npm run db:seed` (no automatic seeding).
