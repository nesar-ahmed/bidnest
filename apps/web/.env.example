# apps/web environment — copy to apps/web/.env (git-ignored).
#
# Next.js loads .env / .env.local from apps/web automatically, before
# next.config.ts is evaluated. Anything prefixed NEXT_PUBLIC_ is inlined into
# the browser bundle — never put secrets in one.
#
# The browser talks to this app's own /api/v1 path (same-origin proxy), so no
# public API URL is needed. This server-side value is where the proxy forwards.
API_INTERNAL_URL=http://localhost:4000
